{
  "name": "easymd",
  "private": true,
  "version": "1.0.4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:serve": "node scripts/desktop-server.mjs",
    "desktop:install": "node scripts/install-macos.mjs",
    "test": "node --import ./scripts/register-test-loader.mjs --test tests/*.test.mjs",
    "licenses:generate": "node scripts/generate-notices.mjs",
    "desktop:run": "pnpm build && electron .",
    "desktop:package": "pnpm build && node scripts/package-macos.mjs",
    "desktop:smoke": "electron . --smoke-test"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.4",
    "@uiw/react-codemirror": "^4.23.12",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.10",
    "lucide-react": "^1.16.0",
    "marked": "^15.0.7",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "pnpm": {
    "overrides": {
      "katex": "^0.18.10",
      "minimatch": "11.0.3",
      "@electron/asar": "4.3.1",
      "@electron/universal": "3.0.6",
      "glob": "14.0.3",
      "app-builder-lib>electron-builder-squirrel-windows": "-"
    },
    "packageExtensions": {
      "app-builder-lib@26.18.0": {
        "peerDependenciesMeta": {
          "electron-builder-squirrel-windows": {
            "optional": true
          }
        }
      }
    }
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "main": "desktop/main.cjs",
  "author": "Xchat1",
  "description": "Private local Markdown, HTML and text editor for macOS"
}
